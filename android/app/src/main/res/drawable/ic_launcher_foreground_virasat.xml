<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the Virasat heritage arch with beacon rings (from public/icon.svg).
     Scaled to sit inside the 66dp circular safe zone so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="240"
        android:scaleX="0.74"
        android:scaleY="0.74"
        android:translateY="16">
        <!-- Heritage archway -->
        <path
            android:fillAlpha="0.95"
            android:pathData="M128,390 V230 C128,160 200,110 256,90 C312,110 384,160 384,230 V390 H336 V240 C336,195 290,160 256,148 C222,160 176,195 176,240 V390 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="128"
                    android:startY="90"
                    android:endX="384"
                    android:endY="390">
                    <item android:offset="0" android:color="#FFFBBF24" />
                    <item android:offset="0.5" android:color="#FFF59E0B" />
                    <item android:offset="1" android:color="#FFD97706" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Beacon rings -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F59E0B"
            android:strokeAlpha="0.5"
            android:strokeWidth="9"
            android:pathData="M184,270 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F59E0B"
            android:strokeAlpha="0.85"
            android:strokeWidth="9"
            android:pathData="M214,270 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0" />
        <!-- Beacon core -->
        <path
            android:fillColor="#FBBF24"
            android:pathData="M240,270 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />
    </group>
</vector>
