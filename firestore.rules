rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Saved Artisans - synchronized across all connected tourist screens in real time
    match /saved_artisans/{artisanId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Verified Reviews - submitted with ESP32 Proof of Presence
    match /artisan_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.isVerifiedPresence == true 
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment.size() >= 3;
      allow update, delete: if false;
    }
  }
}
